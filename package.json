{
  "name": "website",
  "version": "1.0.62",
  "description": "Here's my website development hosted.",
  "keywords": [
    "website"
  ],
  "homepage": "https://tsickert.com",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/website/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.io:thaibault/.git"
  },
  "main": "dist/index.html",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "weboptimizer build",
    "build:stats": "weboptimizer build --profile --json /tmp/stats.json | sed --regexp-extended 's/^Running \".+$//' | sed --regexp-extended 's/^Consolidate module request \".+$//' >/tmp/stats.json && echo 'Results successfully written to \"/tmp/stats.json\".'",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "weboptimizer serve",
    "start": "yarn serve",
    "test": "weboptimizer test",
    "test:browser": "weboptimizer test:browser",
    "test:coverage": "weboptimizer test:coverage",
    "test:coverage:report": "weboptimizer test:coverage:report",
    "update:website": "website-utilities",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/ejs": "^3.1.5",
    "@types/headroom.js": "^0.12.4",
    "@types/html-minifier": "^4.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.11",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@webcomponents/webcomponentsjs": "^2.8.1",
    "bootstrap-icons": "^1.13.2",
    "clientnode": "^4.0.1533",
    "core-js": "^3.51.0",
    "css-loader": "^7.1.5",
    "cssnano": "^9.9.0",
    "errorreporter": "^1.0.368",
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.5.6",
    "favicons": "^7.3.1",
    "favicons-webpack-plugin": "^6.0.1",
    "globals": "^17.14.0",
    "headroom.js": "^0.12.0",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "legal-notes": "^1.0.35",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.33",
    "postcss-fontpath": "^1.0.0",
    "postcss-import": "^17.0.1",
    "postcss-loader": "^8.2.2",
    "postcss-mixins": "^12.1.2",
    "postcss-nested": "^9.0.1",
    "postcss-preset-env": "^11.6.3",
    "postcss-scss": "^4.0.9",
    "postcss-sprites": "^4.2.1",
    "postcss-url": "^10.1.4",
    "prop-types": "^15.8.1",
    "style-loader": "^4.0.0",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "swiper": "^14.4.0",
    "typescript-eslint": "^8.74.0",
    "ua-parser-js": "^2.0.10",
    "wavesurfer.js": "^8.1.1",
    "web-component-wrapper": "^0.0.625",
    "web-internationalization": "^2.0.61",
    "weboptimizer": "^4.0.126",
    "webpack-dev-server": "^6.1.0",
    "website-utilities": "^1.0.489"
  },
  "resolutions": {
    "colors": "1.4.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webOptimizer": {
    "commandLine": {
      "test": {
        "environments": [
          "jsdom"
        ]
      }
    },
    "development": {
      "includeClient": true,
      "server": {
        "static": {
          "#": "We serve static files from source folder.",
          "__append__": {
            "directory": {
              "__evaluate__": "path.resolve(self.path.source.asset.base)"
            },
            "watch": false
          }
        }
      }
    },
    "favicon": {
      "prefix": "image/favicons-[chunkhash]/"
    },
    "imageSprite": {
      "filterBy": {
        "__evaluate__": "({url}) => url.startsWith('image/carousel/') ? Promise.reject(new Error()) : Promise.resolve()"
      }
    },
    "injection": {
      "chunks": false,
      "entry": {
        "#": "errorreporter\": [\"ua-parser-js\", \"errorreporter\"]",
        "__evaluate__": "2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2].startsWith('test') ? {testBundle: './test.ts'} : {index: ['./index.css', '@webcomponents/webcomponentsjs/webcomponents-bundle.js', '@webcomponents/webcomponentsjs/custom-elements-es5-adapter.js', './index']}"
      },
      "external": {
        "#": "Libs are pre-built webpack bundles; re-bundling them into the test bundle collides their nested webpack runtimes (duplicate __webpack_module_cache__ / infinitely self-referencing re-export getters). Externalize them for the test command so jest resolves the published bundles at runtime.",
        "implicit": {
          "pattern": {
            "include": {
              "__evaluate__": "['@jest/globals'].concat(2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2].startsWith('test') ? [/^(?:clientnode|web-component-wrapper|website-utilities|web-internationalization|errorreporter)(?:$|\\/)/] : [])"
            }
          }
        }
      }
    },
    "library": false,
    "module": {
      "aliases": {
        "web-component-wrapper/decorator$": "web-component-wrapper/compatible/decorator",
        "web-component-wrapper/Web": "web-component-wrapper/compatible/Web"
      },
      "enforceDeduplication": true,
      "html": {
        "options": {
          "sources": {
            "list": [
              "...",
              {
                "attribute": "href",
                "filter": {
                  "__evaluate__": "(tag, attribute, attributes, resourcePath) => attributes.filter(({name}) => name === attribute)[0].value.startsWith('data/')"
                },
                "tag": "a",
                "type": "src"
              }
            ]
          }
        }
      },
      "optimizer": {
        "htmlMinifier": {
          "ignoreCustomComments": [
            {
              "__evaluate__": "/^\\|?[a-z]{2}[A-Z]{2}:/"
            },
            {
              "__evaluate__": "/^[a-z]{2}[A-Z]{2}$/"
            }
          ]
        }
      },
      "preprocessor": {
        "cascadingStyleSheet": {
          "additional": {
            "plugins": {
              "pre": {
                "__append__": [
                  "module.optionalImport('postcss-mixins').then((module) => module?.default)",
                  "module.optionalImport('postcss-nested').then((module) => module?.default)"
                ]
              }
            }
          }
        }
      }
    },
    "offline": null,
    "path": {
      "source": {
        "asset": {
          "cascadingStyleSheet": "./",
          "javaScript": "./"
        }
      },
      "target": {
        "asset": {
          "cascadingStyleSheet": "./",
          "image": {
            "__evaluate__": "({filename}) => `image/${path.dirname(path.resolve(filename).substring(self.path.source.asset.image.length))}/[name][ext]?${self.hashAlgorithm}=[contenthash]`"
          },
          "javaScript": "./"
        }
      }
    },
    "webpack": {
      "snapshot": {
        "unmanagedPaths": [
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]clientnode[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]web-component-wrapper[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]web-internationalization[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]website-utilities[\\/]/"
          }
        ]
      },
      "watchOptions": {
        "ignored": {
          "__remove__": "**/node_modules"
        }
      }
    }
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
